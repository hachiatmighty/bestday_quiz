---
import '../../src/styles/global.css';
import { copy as c } from '../data/copy.mjs';
const noindex = import.meta.env.PUBLIC_LIFE_AUDIT_NOINDEX !== 'false';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontFaces = `@font-face{font-family:Urbanist;src:url('${base}/assets/fonts/Urbanist-Medium.ttf') format('truetype');font-weight:500;font-display:swap}@font-face{font-family:Urbanist;src:url('${base}/assets/fonts/Urbanist-ExtraBold.ttf') format('truetype');font-weight:800;font-display:swap}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{c.pageTitle}</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href="https://bestday.ai/life-audit/" />
    {noindex && <meta name="robots" content="noindex" />}
    <style is:inline set:html={fontFaces}></style>
  </head>
  <body><slot /></body>
</html>
