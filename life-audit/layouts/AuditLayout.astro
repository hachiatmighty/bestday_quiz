---
import '../../src/styles/global.css';
import { copy as c } from '../data/copy.mjs';
const {title=c.pageTitle,description=c.description,path='/life-audit/',image='default',review=false}=Astro.props;
const noindex = review || import.meta.env.PUBLIC_LIFE_AUDIT_NOINDEX !== 'false';
const origin=import.meta.env.PUBLIC_SITE_ORIGIN || 'https://bestday.ai';
const canonical=new URL(path,origin).toString();
const og=new URL(`/life-audit/assets/og/${image}.png`,origin).toString();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Urbanist: 2000 units/em, ascent 1900, descent 500, x-height 1000.
// Arial x-height 0.519em; adjust fallback and match vertical metrics.
// swap, not optional: on a slow first visit optional drops the brand font entirely. The matched fallback keeps the shift small.
const fontFaces = `@font-face{font-family:UrbanistFallback;src:local(Arial);size-adjust:96.34%;ascent-override:98.61%;descent-override:25.95%;line-gap-override:0%}@font-face{font-family:Urbanist;src:url('${base}/assets/fonts/Urbanist-Medium.ttf') format('truetype');font-weight:500;font-display:swap}@font-face{font-family:Urbanist;src:url('${base}/assets/fonts/Urbanist-ExtraBold.ttf') format('truetype');font-weight:800;font-display:swap}`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex"/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={og}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={og}/><link rel="icon" href="/favicon.ico"/><link rel="preload" href={`${base}/assets/fonts/Urbanist-Medium.ttf`} as="font" type="font/ttf" crossorigin/><link rel="preload" href={`${base}/assets/fonts/Urbanist-ExtraBold.ttf`} as="font" type="font/ttf" crossorigin/><style is:inline set:html={fontFaces}></style><style is:global>:root{font-family:Urbanist,UrbanistFallback,Arial,sans-serif}:focus-visible{outline:3px solid #FFDE59;outline-offset:4px}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}</style></head><body><slot/></body></html>
