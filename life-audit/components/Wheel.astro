---
import { areas } from '../data/audit.mjs';
import { exampleRatings, wheelGrid } from '../../src/lib/life-audit-sharing.mjs';
import { wheelGeometry } from '../../src/lib/life-audit.mjs';
const { focus = 'relationships' } = Astro.props;
---
<div class="wheel" data-wheel><svg viewBox="-55 -40 310 280" role="img" aria-label="Example wheel">
{wheelGeometry(exampleRatings).map((s,i)=><path class={`petal ${s.id===focus?'focus':''}`} fill={s.id===focus?'#FFDE59':'#FFFCEF'} style={`--order:${i}`} d={s.path}/>)}
<g set:html={wheelGrid()}/>
{areas.map((a,i)=>{const angle=-Math.PI/2+(i+.5)*Math.PI/4;return <text x={100+Math.cos(angle)*125} y={100+Math.sin(angle)*125} text-anchor="middle" dominant-baseline="middle">{a.short}</text>})}
</svg></div>
<style>.wheel{width:100%;max-width:520px;margin:auto}.wheel svg{width:100%;display:block}.wheel text{font-family:Urbanist,sans-serif;font-size:9px;fill:#FFFCEF}</style>
