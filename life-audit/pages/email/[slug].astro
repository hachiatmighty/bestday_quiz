---
import AuditLayout from '../../layouts/AuditLayout.astro';
import {emails,renderEmail} from '../../data/emails.mjs';
import {postalAddress} from '../../../src/data/emails';
import {LIFE_AUDIT_EMAIL} from '../../data/links.mjs';
import {appLinks} from '../../../src/lib/signup';
export function getStaticPaths(){return emails.map(email=>({params:{slug:email.slug},props:{email}}))}
const email=renderEmail(Astro.props.email);
---
<AuditLayout review title={email.subject}><main class="email-preview"><nav><a href="/life-audit/email/">All previews</a><p>{email.timing}. Review only. Sample recipient Amara.</p></nav><article><img src="/life-audit/assets/logos/wordmark-black.png" width="126" alt="Bestday"/><h1>{email.subject}</h1>{email.paragraphs.map((p: string)=><p>{p}</p>)}<a class="button" href={LIFE_AUDIT_EMAIL || appLinks.email}>{email.cta}</a>{email.note && <p class="note">{email.note}</p>}<p>{email.signoff}</p><footer>You're getting this because you took the Bestday Life Audit. <a href="https://bestday.ai/unsubscribe">Unsubscribe</a>.<br/>{postalAddress}</footer></article></main></AuditLayout>
<style>main{max-width:650px;margin:30px auto;padding:0 16px}article{background:#FFFCEF;color:#0D0D0D;padding:32px;border-radius:12px}h1{font-size:36px;line-height:1.1}p{white-space:pre-line;font-size:18px;line-height:1.6}p.note{font-size:14px;margin-top:12px}footer{font-size:12px;line-height:1.5;border-top:1px solid #0D0D0D;padding-top:24px}</style>
