---
import AuditLayout from '../layouts/AuditLayout.astro';
import Wheel from '../components/Wheel.astro';
import ShareActions from '../../src/components/ShareActions.astro';
import { copy as c } from '../data/copy.mjs';
const faq = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:c.faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<AuditLayout>
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
<header><a href="/life-audit/" aria-label={c.homeLabel}>{c.brand}<span>®</span></a><span>{c.title}</span></header>
<main>
<section id="landing">
<div class="hero"><div class="hero-copy"><p class="kicker">{c.eyebrow}</p><h1>{c.headline}</h1><p class="lede">{c.subline}</p><button class="button" data-start>{c.start}<span aria-hidden="true">↗</span></button></div><div class="example"><Wheel/><p>{c.wheel}</p></div></div>
<div class="editorial"><p class="kicker">{c.how}</p><div class="steps">{c.steps.map(([title,body],i)=><article><span class="index">0{i+1}</span><h2>{title}</h2><p>{body}</p></article>)}</div><div class="method"><h2>{c.method}</h2><p>{c.methodBody}</p></div><h2>{c.faqTitle}</h2><div class="faqs">{c.faqs.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div>
</section>
<section id="flow" hidden><div class="flow-shell"><button class="quiet" data-back>{c.back}</button><div id="stage" aria-live="polite"></div></div></section>
<section id="gate" hidden><div class="gate-shell"><button class="quiet" data-teaser-back>{c.back}</button><p class="kicker">{c.emailNote}</p><h1 tabindex="-1">{c.gate}</h1><form data-capture-form><label>{c.firstName}<input name="firstName" autocomplete="given-name" required/></label><label>{c.email}<input name="email" type="email" autocomplete="email" required/></label><p class="consent-copy">{c.consent} <a href="https://bestday.ai/privacy">{c.privacy}</a></p><label><span>{c.whatsapp} <span class="muted">{c.optional}</span></span><input name="whatsapp" type="tel" autocomplete="tel"/></label><label class="checkbox" data-phone-consent hidden><input name="whatsappConsent" type="checkbox"/><span>{c.whatsappConsent}</span></label><button class="button" type="submit">{c.show}</button><p role="status" data-status></p></form></div></section>
<section id="result" hidden><div class="result-layout"><aside><p class="kicker">{c.wheel}</p><div data-result-wheel></div><h1 data-focus-name tabindex="-1"></h1><p data-result-context></p></aside><div class="result-copy"><section><p class="section-number">01</p><h2>{c.shows}</h2><p data-reflection></p></section><section><p class="section-number">02</p><h2>{c.why}</h2><p>{c.chosen}</p><p data-area-reflection></p></section><section><p class="section-number">03</p><h2>{c.goals}</h2><p>{c.goalsBody}</p><div data-goals></div><label class="edit-label">{c.edit}<textarea data-goal-edit rows="3" maxlength="300"></textarea></label></section><section><h2>{c.horizon}</h2><div class="pills" data-horizons></div></section><section><h2>{c.firstStep}</h2><label class="sr-only" for="first-step">{c.firstStep}</label><textarea id="first-step" rows="3" maxlength="400"></textarea><p>{c.day}</p><div class="days" data-days></div></section><blockquote><h2>{c.quote}</h2><p>{c.quoteBody}</p></blockquote><section><h2>{c.share}</h2><p>{c.shareBody}</p><p class="commitment" data-commitment></p><ShareActions prefix="audit-"/><p role="status" data-share-status></p></section><section class="offer"><a class="button" data-signup href="#">{c.circle}<span aria-hidden="true">↗</span></a><p class="small">{c.pricing}</p><p role="status" data-link-status></p><button class="quiet" data-again>{c.again}</button></section></div></div></section>
</main>
<footer><a href="https://bestday.ai">{c.brand}</a><span>{c.signature}</span><a href="https://bestday.ai/privacy">{c.privacy}</a></footer>
<script>import '../client';</script>
<style is:global>
[hidden]{display:none!important}body{font-weight:500}button,a,input,textarea{ -webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #FFDE59;outline-offset:4px}textarea{font:inherit}header,footer{display:flex;align-items:center;justify-content:space-between;padding:24px max(24px,calc((100vw - 1280px)/2));gap:16px}header{background:#FFFCEF;color:#0D0D0D;border-bottom:1px solid #0d0d0d20}header>a,footer>a:first-child{font-size:30px;font-weight:800;letter-spacing:-2px;text-decoration:none}header>a span{font-size:12px;vertical-align:top;letter-spacing:0}header>span{font-size:12px}footer{border-top:1px solid #fffcef30;font-size:13px;padding-top:36px;padding-bottom:36px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-weight:800;letter-spacing:-.045em}h1{font-size:clamp(38px,5vw,76px);line-height:1.02;white-space:pre-line;margin-bottom:24px}h2{font-size:clamp(28px,3vw,42px);line-height:1.08;margin-bottom:18px}p{line-height:1.6}button{font-weight:800}.kicker{font-size:12px;letter-spacing:.06em;margin-bottom:24px}.hero{background:#FFFCEF;color:#0D0D0D;display:grid;align-items:center;gap:24px;padding:60px 24px 45px}.hero h1{font-size:clamp(39px,5.2vw,76px)}.hero .lede{max-width:430px;font-size:18px;margin-bottom:28px}.button{gap:36px;min-height:56px;padding:16px 25px;font-size:16px}.example{text-align:center;background:#0D0D0D;color:#FFFCEF;border-radius:16px;padding:24px 8px 8px}.example>p{font-size:12px}.wheel svg{display:block;width:100%;overflow:visible}.wheel{width:100%;max-width:520px;margin:auto}.wheel text{font-family:Urbanist,sans-serif;font-size:9px;fill:currentColor}.guide{fill:none;stroke:currentColor;stroke-width:.6;opacity:.25}.petal{fill:#FFFCEF;stroke:#0D0D0D;stroke-width:.7;transform-origin:100px 100px}.wheel.animate .petal,.example .petal{animation-name:grow;animation-duration:.65s;animation-delay:calc(var(--order)*.12s);animation-fill-mode:both;animation-timing-function:cubic-bezier(.2,.7,.2,1)}.wheel .focus{fill:#FFDE59;animation-name:focus-grow!important}.missing{fill:none;stroke:currentColor;stroke-width:1;stroke-dasharray:3 3;opacity:.45}.skip-label{font-size:6px!important;opacity:.7}.editorial{max-width:1180px;margin:auto;padding:64px 24px 80px}.steps{display:grid;gap:36px;margin:38px 0 80px}.index,.section-number{color:#FFDE59;font-size:12px}.steps h2{font-size:28px;margin:18px 0 12px}.steps p,.method p,.faqs p{color:#fffcefb3}.method{display:grid;gap:12px;padding-bottom:64px}.faqs{margin-top:30px}details{border-top:1px solid #fffcef40;padding:23px 0}summary{list-style:none;display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-size:19px;font-weight:800}details p{margin:16px 0 0;max-width:700px}.flow-shell,.gate-shell{max-width:720px;margin:auto;padding:28px 24px 72px;min-height:80svh}.gate-shell{max-width:550px}.quiet{background:none;border:0;color:inherit;text-decoration:underline;text-underline-offset:5px;padding:12px 0;font-size:14px;margin-bottom:24px}.screen-heading{font-size:clamp(36px,4vw,56px)}.options{display:grid;gap:12px;margin-top:30px}.option{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;padding:21px 22px;text-align:left;border:1px solid #fffcef50;background:transparent;border-radius:16px;color:#FFFCEF;font-size:18px;line-height:1.3}.option.selected,.option:hover{border-color:#FFDE59}.option.selected{box-shadow:inset 4px 0 #FFDE59}.option span:last-child{color:#FFDE59}.progress-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:-12px 0 20px;font-size:13px}.mini{width:110px}.mini text{display:none}.rating-prompt{min-height:65px;color:#fffcefb3;font-size:18px}.ratings{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin:30px 0 18px}.rating{border:1px solid #fffcef70;background:none;color:#FFFCEF;border-radius:999px;min-height:47px;font-size:18px}.rating.selected{background:#FFDE59;color:#0D0D0D;border-color:#FFDE59}.scale-labels{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:#fffcefb3}.scale-labels span:nth-child(2){color:#FFFCEF}.teaser-wheel{max-width:370px;margin:auto}.focus-title{color:#FFDE59}.locked{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:24px 0}.lock{border:1px solid #fffcef40;border-radius:12px;padding:18px 14px;font-size:14px}.lock span{display:block;opacity:.5;font-size:17px;margin-bottom:15px}.teaser-heading{font-size:25px;margin-top:32px}.small,.consent-copy{font-size:13px;line-height:1.5}.muted{opacity:.6}form label,.edit-label{display:grid;gap:10px;margin:22px 0;font-size:14px}input:not([type=checkbox]),textarea{width:100%;background:transparent;border:1px solid #fffcef70;border-radius:12px;padding:16px;color:#FFFCEF;min-width:0}textarea{resize:vertical;line-height:1.5}.checkbox{grid-template-columns:auto 1fr;align-items:start;line-height:1.5}.checkbox input{margin-top:4px}.gate-shell h1{font-size:44px}.result-layout{max-width:1280px;margin:auto;padding:40px 24px 70px;display:grid;gap:36px}.result-layout aside h1{font-size:38px;color:#FFDE59}.result-layout aside{text-align:center;align-self:start}.result-copy>section{padding:24px 0 38px;border-bottom:1px solid #fffcef30}.result-copy p{color:#fffcefc9}.result-copy .option{margin:12px 0;font-size:17px}.pills,.days{display:flex;gap:8px}.pills button,.days button{border:1px solid #fffcef70;background:none;color:#FFFCEF;border-radius:999px;padding:13px 18px}.days{justify-content:space-between}.days button{padding:13px 10px;font-size:12px}.pills .selected,.days .selected{background:#FFFCEF;color:#0D0D0D}blockquote{margin:25px 0;background:#FFFCEF;color:#0D0D0D;padding:30px 24px;border-radius:3px}blockquote p{color:#0D0D0D!important;margin:0}.commitment{font-size:22px;line-height:1.35!important;color:#FFFCEF!important}.share-actions{display:flex;gap:15px;justify-content:space-between;margin-top:28px}.share-action{display:flex;flex-direction:column;align-items:center;gap:9px;border:0;color:inherit;background:none;text-decoration:none;cursor:pointer;font-size:11px}.action-icon{display:grid;place-items:center;width:48px;height:48px;border:1px solid #fffcef70;border-radius:50%}.action-icon svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.5}.whatsapp svg,.brand svg{fill:currentColor;stroke:none}.offer .quiet{display:block;margin-top:24px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.live-petal{animation-name:grow;animation-duration:.22s;animation-fill-mode:both;animation-timing-function:ease-out}
@keyframes grow{from{transform:scale(0)}to{transform:scale(1)}}@keyframes focus-grow{from{transform:scale(0);fill:#FFFCEF}70%{fill:#FFFCEF}to{transform:scale(1);fill:#FFDE59}}
@media(min-width:800px){.hero{grid-template-columns:1.1fr 1fr;padding:90px max(40px,calc((100vw - 1280px)/2));min-height:700px}.hero h1{max-width:700px}.steps{grid-template-columns:repeat(3,1fr);gap:70px}.method{grid-template-columns:1fr 1fr;gap:80px}.flow-shell{padding-top:45px}.ratings{grid-template-columns:repeat(11,1fr);gap:9px}.rating{min-height:49px}.result-layout{grid-template-columns:1fr 1.05fr;gap:90px}.result-layout aside{position:sticky;top:35px}.result-copy>section{padding-top:35px}.result-layout aside .wheel{margin-top:20px}.scale-labels{font-size:13px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:0s!important;animation-delay:0s!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</AuditLayout>
