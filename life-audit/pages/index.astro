---
import AuditLayout from '../layouts/AuditLayout.astro';
import WheelOfFigures from '../components/WheelOfFigures.astro';
import ScrollManifesto from '../../src/components/ScrollManifesto.astro';
import { areas } from '../data/audit.mjs';
import ShareActions from '../../src/components/ShareActions.astro';
import { copy as c } from '../data/copy.mjs';
const lines = ["Some seasons, work takes everything.","Some never look at the numbers.","Some keep going on empty.","Some mean to call back. For months.","Some have meant to learn it for years.","Some can't remember their last real day off.","Some live around the thing that's broken.","Some wonder what it all adds up to."];
const faq = {'@context':'https://schema.org','@type':'FAQPage',mainEntity:c.faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))};
---
<AuditLayout>
<script type="application/ld+json" set:html={JSON.stringify(faq)} /><script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"WebApplication",name:"Bestday Life Audit",applicationCategory:"LifestyleApplication",operatingSystem:"Any",offers:{"@type":"Offer",price:"0",priceCurrency:"USD"}})} />
<header><a href="/life-audit/" aria-label={c.homeLabel}><img src="/life-audit/assets/logos/wordmark-black.png" alt="Bestday" width="126" height="40"/></a><span>{c.title}</span></header>
<main>
<section id="landing">
<div class="hero"><h1>{c.headline}</h1><p class="lede">{c.subline}</p><div class="hero-demo"><WheelOfFigures demo={true}/><noscript><style is:inline>.hero-demo .figure-wheel svg{display:none}</style><img class="hero-ring" src="/life-audit/assets/figures/hero-ring.png" alt="Eight people holding a wheel" width="1024" height="1024"/></noscript></div><p class="demo-invitation">Try it. Then take the real one.</p><a class="button" href="#javascript-note" data-start>{c.start}</a><noscript><p id="javascript-note">Turn on JavaScript to take the life audit</p></noscript></div>
<ScrollManifesto><section class="audit-manifesto" data-lines aria-label="The eight life areas"><div class="manifesto-wrap">{areas.map((area,i)=><article class:list={['line',{flip:i%2===1}]}><div class="manifesto-figure"><img class="unlit" src={`/life-audit/assets/figures/${area.id}-grey.webp`} alt=""/><img class="lit" src={`/life-audit/assets/figures/${area.id}.webp`} alt=""/></div><h2>{lines[i]}<span>{area.name}</span></h2></article>)}</div></section></ScrollManifesto>
<section class="manifesto-close"><h2>Which one needs you now?</h2><a class="button" href="#javascript-note" data-start>{c.start}</a></section>
<div class="editorial"><h2>{c.how}</h2><div class="steps">{c.steps.map(([title,body],i)=><article><span class="index">0{i+1}</span><h2>{title}</h2><p>{body}</p></article>)}</div><div class="method"><h2>{c.method}</h2><p>{c.methodBody}</p></div><h2>{c.faqTitle}</h2><div class="faqs">{c.faqs.map(([q,a])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}</div></div>
</section>
<section id="flow" hidden><div class="flow-shell"><button class="quiet" data-back>{c.back}</button><div id="stage" aria-live="polite"></div></div></section>
<section id="gate" hidden><div class="gate-shell"><button class="quiet" data-teaser-back>{c.back}</button><h1 tabindex="-1">{c.gate}</h1><form data-capture-form><label>{c.firstName}<input name="firstName" autocomplete="given-name" required/></label><label>{c.email}<input name="email" type="email" autocomplete="email" required/></label><p class="consent-copy">{c.consent} <a href="https://bestday.ai/privacy">{c.privacy}</a></p><label><span>{c.whatsapp} <span class="muted">{c.optional}</span></span><input name="whatsapp" type="tel" autocomplete="tel"/></label><label class="checkbox" data-phone-consent hidden><input name="whatsappConsent" type="checkbox"/><span>{c.whatsappConsent}</span></label><button class="button" type="submit">{c.show}</button><p role="alert" aria-atomic="true" data-status></p></form></div></section>
<section id="result" hidden><div class="result-layout"><aside><div data-result-wheel></div><h1 data-focus-name tabindex="-1"></h1><div data-delivery-status role="status" hidden><p>We couldn't send your copy just now. Your result is here, and you can try again.</p><button class="quiet" data-capture-retry>Try again</button></div><p data-result-context></p></aside><div class="result-copy"><section><h2>{c.shows}</h2><p data-reflection></p></section><section><h2>{c.why}</h2><p>{c.chosen}</p><p data-area-reflection></p></section><section><h2>{c.goals}</h2><p>{c.goalsBody}</p><div data-goals></div><label class="edit-label">{c.edit}<textarea data-goal-edit rows="3" maxlength="300"></textarea></label></section><section><h2>{c.horizon}</h2><div class="pills" data-horizons></div></section><section><h2>{c.firstStep}</h2><label class="sr-only" for="first-step">{c.firstStep}</label><textarea id="first-step" rows="3" maxlength="400"></textarea><p>{c.day}</p><div class="days" data-days></div></section><blockquote><h2>{c.quote}</h2><p>{c.quoteBody}</p></blockquote><section><h2>{c.share}</h2><p>{c.shareBody}</p><p class="commitment" data-commitment></p><label class="checkbox"><input type="checkbox" data-include-wheel/><span>Include my wheel</span></label><ShareActions prefix="audit-"/><p role="status" data-share-status></p></section><section data-referral hidden><h2 data-referral-title></h2><p data-referral-line></p><a class="button" data-referral-signup>Add them to your circle</a></section><section class="offer"><a class="button" data-signup href="#">{c.circle}</a><p class="small">{c.pricing}</p><button class="quiet" data-again>{c.again}</button></section></div></div></section>
</main>
<footer><a href="https://bestday.ai"><img src="/life-audit/assets/logos/wordmark-white.png" alt="Bestday" width="126" height="40"/></a><span>{c.signature}</span><a href="https://bestday.ai/privacy">{c.privacy}</a></footer>
<script>import '../client';</script>
<style is:global>
[hidden]{display:none!important}body{font-weight:500}button,a,input,textarea{ -webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #FFDE59;outline-offset:4px}textarea{font:inherit}header,footer{display:flex;align-items:center;justify-content:space-between;padding:24px max(24px,calc((100vw - 1280px)/2));gap:16px}header{background:#FFFCEF;color:#0D0D0D;border-bottom:1px solid #0d0d0d20}header>a,footer>a:first-child{font-size:30px;font-weight:800;letter-spacing:-2px;text-decoration:none}header>a span{font-size:12px;vertical-align:top;letter-spacing:0}header>span{font-size:12px}footer{border-top:1px solid #fffcef30;font-size:13px;padding-top:36px;padding-bottom:36px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-weight:800;letter-spacing:-.045em}h1{font-size:clamp(38px,5vw,76px);line-height:1.02;white-space:pre-line;margin-bottom:24px}h2{font-size:clamp(28px,3vw,42px);line-height:1.08;margin-bottom:18px}p{line-height:1.6}button{font-weight:800}.hero{background:#FFFCEF;color:#0D0D0D;display:grid;align-items:center;gap:24px;padding:60px 24px 45px}.hero h1{font-size:clamp(39px,5.2vw,76px)}.hero .lede{max-width:430px;font-size:18px;margin-bottom:28px}.button{gap:36px;min-height:56px;padding:16px 25px;font-size:16px}.editorial{max-width:1180px;margin:auto;padding:64px 24px 80px}.steps{display:grid;gap:36px;margin:38px 0 80px}.index{color:#FFDE59;font-size:12px}.steps h2{font-size:28px;margin:18px 0 12px}.steps p,.method p,.faqs p{color:var(--muted)}.method{display:grid;gap:12px;padding-bottom:64px}.faqs{margin-top:30px}details{border-top:1px solid #fffcef40;padding:23px 0}summary{list-style:none;display:flex;justify-content:space-between;gap:20px;cursor:pointer;font-size:19px;font-weight:800}details p{margin:16px 0 0;max-width:700px}.flow-shell,.gate-shell{max-width:720px;margin:auto;padding:28px 24px 72px;min-height:80svh}.gate-shell{max-width:550px}.quiet{background:none;border:0;color:inherit;text-decoration:underline;text-underline-offset:5px;padding:12px 0;font-size:14px;margin-bottom:24px}.screen-heading{font-size:clamp(36px,4vw,56px)}.options{display:grid;gap:12px;margin-top:30px}.option{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;padding:21px 22px;text-align:left;border:1px solid var(--muted);background:transparent;border-radius:16px;color:#FFFCEF;font-size:18px;line-height:1.3}.option.selected,.option:hover{border-color:#FFDE59}.option.selected{box-shadow:inset 4px 0 #FFDE59}.choice-check{color:#FFDE59;width:16px;flex:0 0 16px}.option-label{flex:1;min-width:0}.option-label:has(.rating-summary){display:grid;grid-template-columns:minmax(0,1fr) 104px;gap:12px;align-items:center}.rating-summary{display:flex;align-items:center;gap:8px}.rating-value{width:40px;text-align:right;font-variant-numeric:tabular-nums;font-size:14px}.rating-bar{width:56px;height:4px;background:#fffcef30;border-radius:4px;overflow:hidden}.rating-bar>span{display:block;height:100%;background:#FFFCEF}.selected .rating-bar>span{background:#FFDE59}.progress-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 20px;font-size:13px}.progress-row .mini{width:72px;flex:0 0 72px;margin:0}.mini text{display:none}.rating-prompt{min-height:65px;color:var(--muted);font-size:18px}.ratings{display:grid;grid-template-columns:repeat(6,1fr);gap:9px;margin:30px 0 18px}.rating{border:1px solid var(--muted);background:none;color:#FFFCEF;border-radius:999px;min-height:47px;font-size:18px}.rating.selected{background:#FFDE59;color:#0D0D0D;border-color:#FFDE59}.scale-labels{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:var(--muted)}.scale-labels span:nth-child(2){color:#FFFCEF}.teaser-wheel{max-width:370px;margin:auto}.focus-title{color:#FFDE59}.locked{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:24px 0}.lock{border:1px solid var(--muted);border-radius:12px;padding:18px 14px;font-size:14px}.lock span{display:block;opacity:.5;font-size:17px;margin-bottom:15px}.teaser-heading{font-size:25px;margin-top:32px}.small,.consent-copy{font-size:13px;line-height:1.5}.muted{color:var(--muted)}form label,.edit-label{display:grid;gap:10px;margin:22px 0;font-size:14px}input:not([type=checkbox]),textarea{width:100%;background:transparent;border:1px solid var(--muted);border-radius:12px;padding:16px;color:#FFFCEF;min-width:0}textarea{font:inherit;resize:vertical;line-height:1.5}.checkbox{grid-template-columns:auto 1fr;align-items:start;line-height:1.5}.checkbox input{margin-top:4px}.gate-shell h1{font-size:44px}.result-layout{max-width:1280px;margin:auto;padding:40px 24px 70px;display:grid;gap:36px}.result-layout aside h1{font-size:38px;color:#FFDE59}.result-layout aside{text-align:center;align-self:start;height:fit-content}.result-copy>section{padding:24px 0 38px;border-bottom:1px solid #fffcef30}.result-copy p{color:var(--muted)}.result-copy .option{margin:12px 0;font-size:17px}.pills,.days{display:flex;gap:8px}.pills button,.days button{border:1px solid var(--muted);background:none;color:#FFFCEF;border-radius:999px;padding:13px 18px}.days{justify-content:space-between}.days button{padding:13px 10px;font-size:12px}.pills .selected,.days .selected{background:#FFFCEF;color:#0D0D0D}blockquote{margin:25px 0;background:#FFFCEF;color:#0D0D0D;padding:30px 24px;border-radius:3px}blockquote p{color:#0D0D0D!important;margin:0}.commitment{font-size:22px;line-height:1.35!important;color:#FFFCEF!important}.share-actions{display:flex;gap:15px;justify-content:space-between;margin-top:28px}.share-action{display:flex;flex-direction:column;align-items:center;gap:9px;border:0;color:inherit;background:none;text-decoration:none;cursor:pointer;font-size:11px}.action-icon{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--muted);border-radius:50%}.action-icon svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.5}.whatsapp svg,.brand svg{fill:currentColor;stroke:none}.offer .quiet{display:block;margin-top:24px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.live-petal{animation-name:grow;animation-duration:.22s;animation-fill-mode:both;animation-timing-function:ease-out}
@keyframes grow{from{transform:scale(0)}to{transform:scale(1)}}@keyframes focus-grow{from{transform:scale(0);fill:#FFFCEF}70%{fill:#FFFCEF}to{transform:scale(1);fill:#FFDE59}}
@media(min-width:800px){.progress-row .mini{width:96px;flex-basis:96px}.hero{grid-template-columns:1fr;padding:90px max(40px,calc((100vw - 1280px)/2));min-height:700px}.hero h1{max-width:700px}.steps{grid-template-columns:repeat(3,1fr);gap:70px}.method{grid-template-columns:1fr 1fr;gap:80px}.flow-shell{padding-top:45px}.ratings{grid-template-columns:repeat(11,1fr);gap:9px}.rating{min-height:49px}.result-layout{grid-template-columns:1fr 1.05fr;gap:90px}.result-layout aside{position:sticky;top:32px}.result-copy{font-size:18px;line-height:1.65;min-width:0}.result-copy>section{padding-top:32px}.result-layout aside .wheel{margin-top:20px}.scale-labels{font-size:13px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:0s!important;animation-delay:0s!important;transition:none!important;scroll-behavior:auto!important}}
</style>
</AuditLayout>
