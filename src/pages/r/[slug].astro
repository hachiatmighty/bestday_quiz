---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archetypes, archetypeOrder } from '../../data/quiz';
export function getStaticPaths() { return archetypeOrder.map(slug => ({ params: { slug }, props: { slug } })); }
const { slug } = Astro.props;
const result = archetypes[slug];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;
const quizUrl = new URL(`${base}?ref=${slug}`, Astro.site);
const cardFooter = new URL(base, Astro.site).host + base.replace(/\/$/, '');
---
<BaseLayout title={`I'm ${result.name}. What are you?`} description="A two-minute quiz on how you go after goals, and who you do it best with." image={assetUrl(`assets/og/${slug}.png`)}>
  <main class="share-page">
    <div class="shell">
      <img class="wordmark" src={assetUrl('assets/logos/wordmark-white.png')} alt="Bestday" />
      <article class="result-card">
        <span class="pictogram"><img src={assetUrl(`assets/illustrations/${result.pictogram}`)} alt="" /></span>
        <p>I'm</p><h1>{result.name}</h1><strong>{result.cardLine}</strong>
        <img class="card-logo" src={assetUrl('assets/logos/wordmark-white.png')} alt="Bestday" />
        <span class="card-url">{cardFooter}</span>
      </article>
      <h2>What type are you when a goal gets real?</h2>
      <p class="lead">Take the quiz, then send your result to one person who tells you the truth.</p>
      <a class="button" href={quizUrl}>Find my type</a>
    </div>
  </main>
</BaseLayout>
<style>
.share-page { min-height: 100svh; padding: 28px 0 70px; }
.wordmark { width: 112px; margin-bottom: 28px; }
.result-card { position: relative; overflow: hidden; min-height: 510px; padding: 28px; border: 1px solid #2A2A2A; border-radius: 12px; display: flex; flex-direction: column; justify-content: flex-end; background: var(--black); color: var(--cream); }
.pictogram { position: absolute; width: 68%; max-width: calc(100% - 48px); aspect-ratio: 1; top: 24px; left: 50%; transform: translateX(-50%); display: grid; place-items: center; }
.pictogram img { width: 84%; height: 84%; object-fit: contain; }
.result-card p { color: var(--yellow); margin: 0; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
.result-card h1 { color: var(--yellow); margin: 5px 0 8px; font-size: clamp(3.2rem, 15vw, 6rem); line-height: .88; letter-spacing: -.06em; max-width: 90%; }
.result-card strong { font-size: 1.2rem; max-width: 440px; }
.card-logo { width: 94px; margin-top: 26px; }
.card-url { color: var(--cream); font-size: .82rem; margin-top: 8px; }
h2 { font-size: clamp(2rem, 9vw, 3.3rem); line-height: 1; letter-spacing: -.04em; margin: 42px 0 12px; }
.lead { color: #d7d4c8; line-height: 1.5; margin-bottom: 25px; }
</style>
