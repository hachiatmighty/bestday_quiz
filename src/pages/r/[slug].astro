---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archetypes, archetypeOrder } from '../../data/quiz';
export function getStaticPaths() { return archetypeOrder.map(slug => ({ params: { slug }, props: { slug } })); }
const { slug } = Astro.props;
const result = archetypes[slug];
const quizUrl = new URL(`/?ref=${slug}`, Astro.site);
---
<BaseLayout title={`I'm ${result.name}. What are you?`} description="A one-minute quiz on how you go after goals, and who you do it best with." image={`/assets/og/${slug}.svg`}>
  <main class="share-page">
    <div class="shell">
      <img class="wordmark" src="/assets/logos/wordmark-white.png" alt="Bestday" />
      <article class="result-card">
        <img class="pictogram" src={`/assets/illustrations/${result.pictogram}`} alt="" />
        <p>I'm</p><h1>{result.name}</h1><strong>{result.cardLine}</strong>
      </article>
      <h2>What type are you when a goal gets real?</h2>
      <p class="lead">Take the quiz, then send your result to one person who tells you the truth.</p>
      <a class="button" href={quizUrl}>Find my type</a>
    </div>
  </main>
</BaseLayout>
<style>
.share-page { min-height: 100svh; padding: 28px 0 70px; }
.wordmark { width: 112px; margin-bottom: 28px; }
.result-card { position: relative; overflow: hidden; min-height: 510px; padding: 28px; border-radius: 12px; display: flex; flex-direction: column; justify-content: flex-end; background: var(--yellow); color: var(--black); }
.pictogram { position: absolute; width: 68%; height: 58%; object-fit: contain; top: 24px; right: -6%; }
.result-card p { margin: 0; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
.result-card h1 { margin: 5px 0 8px; font-size: clamp(3.2rem, 15vw, 6rem); line-height: .88; letter-spacing: -.06em; max-width: 90%; }
.result-card strong { font-size: 1.2rem; max-width: 440px; }
h2 { font-size: clamp(2rem, 9vw, 3.3rem); line-height: 1; letter-spacing: -.04em; margin: 42px 0 12px; }
.lead { color: #d7d4c8; line-height: 1.5; margin-bottom: 25px; }
</style>
