---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { emails } from '../../data/emails';
---
<BaseLayout title="Email journey preview" description="Review-only HTML previews for the Bestday quiz email journey.">
  <main class="shell email-index"><p class="eyebrow">Review only</p><h1>Email journey</h1><p>Final copy pack v2 rendered as mobile-first HTML previews. No messages are sent.</p><div class="list">{emails.map((email, index) => <a href={`/email/${email.slug}`}><b>{index + 1}</b><span>{email.subject}</span></a>)}</div></main>
</BaseLayout>
<style>.email-index{padding:56px 0}.email-index h1{font-size:3.5rem;margin:12px 0}.list{display:grid;gap:12px;margin-top:30px}.list a{display:flex;gap:16px;padding:18px;border:1px solid #3c3c36;border-radius:12px;text-decoration:none}.list b{color:var(--yellow)}</style>
