---
import { emails } from '../../data/emails';
export function getStaticPaths() { return emails.map(email => ({ params: { slug: email.slug }, props: { email } })); }
const { email } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>{email.subject}</title></head><body style="margin:0;background:#ecebe5;font-family:Arial,sans-serif;color:#0D0D0D"><div style="display:none;max-height:0;overflow:hidden">{email.preview}</div><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td style="padding:32px 14px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;margin:auto;background:#FFFCEF;border-radius:12px;overflow:hidden"><tr><td style="background:#0D0D0D;padding:28px;color:#FFDE59;font-weight:800;font-size:24px">Bestday</td></tr><tr><td style="padding:38px 28px"><p style="font-size:12px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin:0 0 16px">{email.timing} · Review preview</p><h1 style="font-size:38px;line-height:1;margin:0 0 10px">{email.subject}</h1><p style="font-size:15px;color:#555;margin:0 0 28px">{email.preview}</p>{email.paragraphs.map(paragraph => paragraph.split('\n').map(line => <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{line || <br />}</p>))}<a href="#" style="display:inline-block;background:#FFDE59;color:#0D0D0D;text-decoration:none;padding:16px 24px;border-radius:999px;font-weight:800">{email.cta}</a>{email.note && <p style="font-size:14px;margin:14px 0 0">{email.note}</p>}<p style="font-size:17px;white-space:pre-line;line-height:1.55;margin:28px 0 0">{email.signoff}</p></td></tr><tr><td style="padding:24px 28px;background:#FFDE59;font-size:12px;line-height:1.5">You're getting this because you took the Bestday quiz. <a href="#" style="color:#0D0D0D">Unsubscribe</a>.<br />[Postal address]</td></tr></table></td></tr></table></body></html>
