---
import { archetypeOrder, archetypes, pairingsFor, type ArchetypeSlug } from '../data/quiz';
import { emails, postalAddress, renderEmailPreview } from '../data/emails';
const { email, type = 'anchor' } = Astro.props as { email: (typeof emails)[number], type: ArchetypeSlug };
const preview = renderEmailPreview(email, type);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const result = archetypes[type];
const isResult = email.slug === 'result';
const isPeople = email.slug === 'people';
const typePairings = pairingsFor(type);
const siteOrigin = import.meta.env.PUBLIC_SITE_ORIGIN ?? 'https://bestday.ai';
const quizOrigin = new URL(base.replace(/^\//, ''), `${siteOrigin}/`).toString();
const logoUrl = new URL('assets/logos/wordmark-white.png', quizOrigin).toString();
const cardUrl = new URL(`assets/cards/${type}.png`, quizOrigin).toString();
const ctaUrl = email.slug === 'people'
  ? new URL(`r/${type}?ref=${type}`, quizOrigin).toString()
  : new URL(`start?ref=email&type=${type}`, quizOrigin).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{preview.subject}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@500;800&display=swap" rel="stylesheet" />
  </head>
  <body style="margin:0;background:#ecebe5;font-family:Urbanist,Arial,sans-serif;color:#0D0D0D">
    <nav style="max-width:600px;margin:20px auto 0;padding:0 14px;display:flex;gap:8px;flex-wrap:wrap">
      {archetypeOrder.map(slug => <a href={`${base}email/${slug}/${email.slug}`} style={`padding:8px 12px;border-radius:999px;text-decoration:none;background:${slug === type ? '#0D0D0D' : '#FFDE59'};color:${slug === type ? '#FFDE59' : '#0D0D0D'};font-weight:700`}>{archetypes[slug].name}</a>)}
    </nav>
    <p style="max-width:600px;margin:14px auto 0;padding:0 14px;font-size:14px;color:#555">{preview.timing} · Review preview · {result.name}</p>
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all">{preview.preview}</div>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr><td style="padding:20px 14px 32px">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;margin:auto;background:#FFFCEF;border-radius:12px;overflow:hidden">
          <tr><td style="background:#0D0D0D;padding:28px"><img src={logoUrl} width="126" alt="Bestday" style="display:block;width:126px;height:auto;border:0" /></td></tr>
          <tr><td style="padding:38px 28px">
            <h1 style="font-size:38px;line-height:1;margin:0 0 10px">{preview.subject}</h1>
            {isResult ? (
              <>
                <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{preview.paragraphs[0]}</p>
                <img src={cardUrl} width="280" alt={`Your Bestday card: ${result.name}`} style="display:block;width:100%;max-width:280px;height:auto;border:0;margin:20px auto 12px" />
                <p style="font-size:15px;line-height:1.5;text-align:center;margin:0 0 24px">Save it, or send it to someone who'd know.</p>
                <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{preview.paragraphs[1]}</p>
                <p style="font-size:17px;line-height:1.55;margin:0 0 14px">{result.identity}</p>
                <h2 style="font-size:20px;line-height:1.25;margin:22px 0 6px">Your strengths</h2>
                <p style="font-size:17px;line-height:1.55;margin:0 0 14px">{result.strength}</p>
                <h2 style="font-size:20px;line-height:1.25;margin:22px 0 6px">The pattern to watch</h2>
                <p style="font-size:17px;line-height:1.55;margin:0 0 14px">{result.tendency}</p>
                <h2 style="font-size:20px;line-height:1.25;margin:22px 0 6px">What you need</h2>
                <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{result.need}</p>
                <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{preview.paragraphs[3]}</p>
              </>
            ) : isPeople ? (
              <>
                {preview.paragraphs.slice(0, 3).map(paragraph => <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{paragraph}</p>)}
                <p style="font-size:17px;line-height:1.55;margin:0 0 8px">Three questions help:</p>
                <ul style="font-size:17px;line-height:1.45;margin:0 0 16px;padding-left:22px">
                  {preview.paragraphs[3].split('\n').slice(2).map(question => <li style="margin:0 0 6px">{question.replace(/^•\s*/, '')}</li>)}
                </ul>
                {preview.paragraphs.slice(4).map(paragraph => <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{paragraph}</p>)}
                <h2 style="font-size:24px;line-height:1.2;margin:30px 0 8px">How you fit with each type</h2>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
                  {typePairings.map(pairing => (
                    <tr><td style="padding:13px 0;border-bottom:1px solid #D7D3C4">
                      <strong style="display:block;font-size:17px;line-height:1.3">{pairing.label}</strong>
                      <span style="display:block;font-size:16px;line-height:1.45;margin-top:3px">{pairing.line}</span>
                    </td></tr>
                  ))}
                </table>
                <p style="font-size:17px;line-height:1.55;font-weight:800;margin:18px 0 20px">Send it to them and find out which one they are.</p>
              </>
            ) : preview.paragraphs.map(paragraph => paragraph.split('\n').filter(Boolean).map(line => <p style="font-size:17px;line-height:1.55;margin:0 0 16px">{line}</p>))}
            <a href={ctaUrl} style="display:inline-block;background:#FFDE59;color:#0D0D0D;text-decoration:none;padding:16px 24px;border-radius:999px;font-weight:800">{preview.cta}</a>
            {preview.note && <p style="font-size:14px;margin:14px 0 0">{preview.note}</p>}
            <p style="font-size:17px;white-space:pre-line;line-height:1.55;margin:28px 0 0">{preview.signoff}</p>
          </td></tr>
          <tr><td style="padding:24px 28px;background:#FFDE59;font-size:12px;line-height:1.5">You're getting this because you took the Bestday quiz. <a href="https://bestday.ai/unsubscribe" style="color:#0D0D0D">Unsubscribe</a>.<br />{postalAddress}</td></tr>
        </table>
      </td></tr>
    </table>
  </body>
</html>
