---
interface Props {
  prefix?: string;
}

const { prefix = '' } = Astro.props;
const dataAttribute = (action: string) => ({ [`data-${prefix}${action}`]: true });
---
<div class="share-actions">
  <a class="share-action whatsapp" aria-label="Send to WhatsApp" target="_blank" rel="noreferrer" {...dataAttribute('whatsapp')}>
    <span class="action-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.009-.371-.011-.57-.011-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.875 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.999-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.436-9.894 9.892-9.894a9.81 9.81 0 0 1 7.021 2.91 9.79 9.79 0 0 1 2.9 7.03c-.003 5.45-4.446 9.894-9.93 9.894m8.413-18.297A11.81 11.81 0 0 0 12.057 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.143 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.69 1.448h.005c6.56 0 11.894-5.335 11.897-11.893a11.82 11.82 0 0 0-3.491-8.413Z"/></svg>
    </span>
    <span class="caption">WhatsApp</span>
  </a>
  <button class="share-action" aria-label="Share" type="button" {...dataAttribute('share')}>
    <span class="action-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.59 13.51 6.83 3.98M15.41 6.51 8.59 10.49"/></svg>
    </span>
    <span class="caption">Share</span>
  </button>
  <a class="share-action" aria-label="Save card" download {...dataAttribute('save')}>
    <span class="action-icon">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
    </span>
    <span class="caption">Save</span>
  </a>
</div>
