<style>
/* Result pages. Teaser: a compact card (figure, name, share), the two free sections, then the locked sections in grey.
   Full result: the card stays pinned beside the read on wide screens; the pattern and the question get cream moments;
   it ends on the first step and a ready-to-send share. */
.teaser-card,.result-card{min-height:0;padding:24px;display:grid;grid-template-columns:96px 1fr;column-gap:18px;row-gap:16px;align-items:center;justify-content:normal;background:#121211;border:1px solid #2a2a2a;border-radius:20px}
.card-figure{width:96px;height:auto}
.card-head h2{margin:2px 0 10px}
.teaser-card h2,.result-card h2{font-size:clamp(2.3rem,9vw,4.4rem);letter-spacing:-.055em;margin-bottom:12px;max-width:none}
.teaser-card strong,.result-card strong{display:block;font-size:1rem;line-height:1.35}
.card-share{grid-column:1/-1}
.card-url{display:block;margin-top:14px;color:#a9a69d;font-size:.8rem}
.category-dot{top:16px;left:16px;width:14px;height:14px}
.teaser-more{margin-top:40px;padding-top:36px;border-top:1px solid #262622}
.teaser-more h2{font-size:clamp(1.9rem,4vw,2.5rem);margin-bottom:22px}
.teaser-more .locked{display:grid;grid-template-columns:1fr;gap:8px;margin:0 0 26px;padding:0;list-style:none;color:inherit;line-height:1.3}
.locked li{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-radius:14px;background:#141413;color:#55534b;font-weight:800}
.locked li::after{content:"";width:12px;height:10px;border:2px solid #44433d;border-radius:3px;box-shadow:0 -6px 0 -2px #121211,0 -7px 0 -2px #44433d}
.locked li[hidden]{display:none}
.unlock{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px}
.unlock .teaser-access{margin:0}
.result-shell{width:min(100% - 32px,1200px);margin:0 auto;display:grid;gap:0}
.result-split{display:grid;gap:36px}
.result-main{display:grid;gap:28px}
.result-copy{display:grid;gap:40px}
.result-copy section h3{margin:0 0 10px;color:var(--yellow);font-size:1.15rem}
.result-copy section p{margin:0;color:#d8d5c9}
.result-copy .identity{margin:0;font-size:clamp(1.9rem,3.4vw,2.6rem);line-height:1.08;letter-spacing:-.04em;max-width:20ch}
.even-note{margin:-24px 0 0}
.result-copy .pattern{padding:30px 26px;border-radius:24px;background:var(--cream);color:var(--black)}
.result-copy .pattern h3{color:#6b6553}
.pattern blockquote{margin:0 0 16px;font-size:clamp(1.6rem,3vw,2.1rem);font-weight:800;line-height:1.12;letter-spacing:-.035em;max-width:22ch}
.result-copy .pattern p{color:#3d3a30}
.fit-types{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
:global(.fit-type){position:relative;display:grid;justify-items:center;gap:4px;padding:10px 2px 8px;border:1px solid #2f2f2b;border-radius:14px;background:none;color:#b9b6aa;font:inherit;font-size:.7rem;font-weight:800;cursor:pointer}
:global(.fit-type img){width:44px;height:44px;object-fit:contain}
:global(.fit-type[aria-pressed="true"]){border:2px solid var(--yellow);background:#19180f;color:var(--yellow)}
:global(.fit-type.me)::after{content:"You";position:absolute;top:-9px;left:50%;transform:translateX(-50%);padding:1px 7px;border-radius:999px;background:var(--yellow);color:var(--black);font-size:.62rem}
:global(.fit-type:focus-visible){outline:3px solid var(--yellow);outline-offset:3px}
.fit-line{margin:12px 0 0;padding:16px 18px;border-radius:14px;background:#19180f;color:var(--cream)!important;font-weight:800;font-size:1.08rem;line-height:1.4}
.fit-line :global(span){display:block;margin-bottom:6px;color:var(--yellow);font-size:.82rem}
.question-band{margin:56px 0 0;padding:64px 0;background:var(--cream);color:var(--black);text-align:center;box-shadow:0 0 0 100vmax var(--cream);clip-path:inset(0 -100vmax)}
.question-band h3{margin:0;color:#6b6553;font-size:1rem}
.question-band p{max-width:20ch;margin:16px auto 0;font-size:clamp(2.1rem,4.6vw,3.6rem);font-weight:800;line-height:1.05;letter-spacing:-.05em}
.result-close{display:grid;gap:20px;padding:64px 0 28px}
.first-step{display:flex;flex-direction:column;gap:14px;padding:28px;border:2px solid var(--yellow);border-radius:24px}
.first-step[hidden]{display:none}
.first-step h3{margin:0;color:var(--yellow);font-size:1.15rem}
.first-step p{margin:0;font-size:1.2rem;font-weight:800;line-height:1.35}
.first-step .button{align-self:flex-start;margin-top:6px}
.result-close .share{display:flex;flex-direction:column;gap:16px;padding:28px;border:0;border-radius:24px;background:#141413}
.result-close .share h3{margin:0}
.share-message{margin:0;padding:16px 18px;border-radius:18px 18px 18px 4px;background:#1d2a22;color:#e9f2ea;line-height:1.45;overflow-wrap:anywhere}
.result-nav{padding-bottom:40px}
@media(min-width:720px){
  .teaser-card{grid-template-columns:200px 1fr;column-gap:28px;padding:30px 34px}
  .teaser-card .card-figure{width:200px;grid-row:span 2}
  .teaser-card .card-share{grid-column:2}
  .teaser-more .locked{grid-template-columns:1fr 1fr;gap:10px}
  .teaser-more .locked li:last-child{grid-column:1/-1}
  .result-copy .pattern{padding:40px 44px}
  .result-close{grid-template-columns:1fr 1fr;width:min(100%,1000px);margin:0 auto;padding-top:96px}
  :global(.fit-type){font-size:.82rem;padding:12px 6px 10px}
  :global(.fit-type img){width:70px;height:70px}
}
@media(min-width:980px){
  .result-split{grid-template-columns:360px 1fr;gap:72px;align-items:start}
  .result-aside{position:sticky;top:30px}
  .result-card{grid-template-columns:1fr;padding:26px}
  .result-card .card-figure{width:220px;margin:0 auto}
  .result-card h2{font-size:3.3rem}
  .question-band{margin-top:96px;padding:110px 0}
}
@media(min-width:720px) and (max-width:979px){.result-card{grid-template-columns:140px 1fr}.result-card .card-figure{width:140px}}
</style>
