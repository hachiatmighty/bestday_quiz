---
import LandingPage from './LandingPage.astro';
import ShareActions from './ShareActions.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const publicQuizUrl = new URL(base, Astro.site).toString();
const siteOrigin = import.meta.env.PUBLIC_SITE_ORIGIN ?? 'https://bestday.ai';
const cardFooter = new URL(base, Astro.site).host + base.replace(/\/$/, '');
---
<main class="quiz" data-quiz-root data-base-url={base} data-public-url={publicQuizUrl} data-site-origin={siteOrigin}>
  <section class="screen landing active" data-screen="landing"><LandingPage /></section>

  <section class="screen" data-screen="quiz">
    <div class="shell question-shell">
      <button class="back" type="button" data-back hidden>Back</button>
      <div class="progress" data-progress-shell hidden><span data-progress></span></div>
      <p class="eyebrow" data-step-label hidden></p>
      <div data-question></div>
    </div>
  </section>

  <section class="screen" data-screen="loading">
    <div class="shell centered"><p class="eyebrow">Reading your answers...</p></div>
  </section>

  <section class="screen" data-screen="teaser">
    <div class="shell teaser-shell">
      <article class="teaser-card card">
        <img class="card-figure" data-teaser-icon alt="" />
        <div class="card-head"><p class="eyebrow">You're</p><h2 data-teaser-name></h2><strong data-teaser-identity></strong></div>
        <div class="card-share"><ShareActions /></div>
      </article>
      <div class="teaser-copy teaser-details">
        <h3>At your best</h3>
        <p data-teaser-at-best></p>
        <h3>The pattern to watch</h3>
        <p data-teaser-pattern></p>
      </div>
      <div class="teaser-copy teaser-more">
        <h2 data-teaser-more-heading>Seven more parts of your read</h2>
        <ul class="locked">
          <li>Your strengths</li>
          <li>How others see you</li>
          <li>What you need</li>
          <li>Who you work best with</li>
          <li>How you fit with each type</li>
          <li>A question to sit with</li>
          <li data-teaser-first-step-item>Your first step</li>
        </ul>
        <div class="unlock">
          <button class="button" data-unlock>Show my full result</button>
          <p class="teaser-access">We'll send you a copy too.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="screen" data-screen="capture">
    <form class="shell capture card" data-capture-form>
      <label>First name<input name="firstName" autocomplete="given-name" required /></label>
      <label>Email<input type="email" name="email" autocomplete="email" required /></label>
      <p class="consent-copy">We'll email you your result and a few short notes over the next week. Unsubscribe any time. <a href={`${siteOrigin}/privacy`}>Privacy</a></p>
      <label><span class="label-line">WhatsApp number <span>(optional)</span></span><input type="tel" name="whatsapp" autocomplete="tel" data-whatsapp-input /></label>
      <label class="consent whatsapp-consent" hidden><input type="checkbox" name="whatsappConsent" /> <span>Bestday may message me on WhatsApp about my result.</span></label>
      <button class="button" type="submit">Show my full result</button>
      <p class="form-status" data-form-status aria-live="polite"></p>
    </form>
  </section>

  <section class="screen" data-screen="result">
    <div class="result-shell">
      <div class="result-split">
        <aside class="result-aside">
          <article class="result-card card">
            <span class="category-dot" data-category-dot></span>
            <img class="card-figure" data-result-icon alt="" />
            <div class="card-head"><p class="eyebrow">I'm</p><h2 data-result-name></h2><strong data-card-line></strong><span class="card-url">{cardFooter}</span></div>
            <div class="card-share"><ShareActions prefix="result-" /></div>
          </article>
        </aside>
        <div class="result-main">
          <article class="pairing card" data-pairing hidden><p data-pairing-heading></p><strong data-pairing-copy></strong><a class="button" href={siteOrigin} data-signup>Invite them onto your goal</a></article>
          <article class="result-copy">
            <p class="identity" data-result-identity></p>
            <p class="even-note" data-even-note hidden>Your answers were very even, so this one was close. <a href={base}>Try again</a> with your first instinct?</p>
            <section><h3>At your best</h3><p data-result-at-best></p></section>
            <section><h3>Your strengths</h3><p data-result-strength></p></section>
            <section><h3>How others see you</h3><p data-result-others-see></p></section>
            <section class="pattern"><h3>The pattern to watch</h3><blockquote data-result-tendency-lead></blockquote><p data-result-tendency></p></section>
            <section><h3>What you need</h3><p data-result-need></p></section>
            <section><h3>Who you work best with</h3><p data-result-works-best-with></p></section>
            <section class="fit-list" data-fit-list>
              <h3>How you fit with each type</h3>
              <div class="fit-types" data-fit-rows role="group" aria-label="Choose a type"></div>
              <p class="fit-line" data-fit-line aria-live="polite"></p>
            </section>
          </article>
        </div>
      </div>
      <section class="question-band"><h3>A question to sit with</h3><p data-result-question></p></section>
      <div class="result-close">
        <section class="first-step" data-result-first-step-section>
          <h3>Your first step</h3><p data-result-first-step></p>
          <a class="button" href={siteOrigin} data-signup>Start your circle</a>
        </section>
        <article class="share card">
          <h3>Who would tell you the truth about this?</h3>
          <p class="share-message" data-result-message></p>
          <ShareActions prefix="end-" />
        </article>
      </div>
      <div class="result-nav"><button class="button secondary" data-offer>What happens next</button><button class="skip" data-restart>Take it again</button></div>
    </div>
  </section>

  <section class="screen" data-screen="offer">
    <div class="shell centered offer">
      <h2>Put a circle around one goal.</h2>
      <p>On Bestday you choose one goal and invite two or three people you respect onto it. They're on it with you, and an AI companion is there for the thinking in between. No one achieves alone.</p>
      <a class="button" href={siteOrigin} data-signup>Start your circle</a>
      <p class="note">Premium is $99 a year. Your people join free.</p>
    </div>
  </section>
</main>

<script>
  // @ts-nocheck
  import { initAnalytics, track, trackingContext } from '../lib/analytics';
  import { submitCapture } from '../lib/capture';
  import { signupDestination } from '../lib/signup';
  import { isVeryEven, scoreQuizWithDetails } from '../lib/scoring.mjs';
  import { createQuizState, goBack, questionIndexForStep, recordAnswer, recordCategory, startQuiz, stepCount, stepFor } from '../lib/quiz-state.mjs';
  import { archetypes, categories, pairingFor, pairingsFor, questions } from '../data/quiz';
  const mixpanelToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN;
  const captureEndpoint = import.meta.env.PUBLIC_CAPTURE_ENDPOINT;
  initAnalytics(mixpanelToken);
  const root = document.querySelector('[data-quiz-root]');
  const baseUrl = root.dataset.baseUrl;
  const publicQuizUrl = root.dataset.publicUrl;
  const siteOrigin = root.dataset.siteOrigin;
  const screens = [...root.querySelectorAll('[data-screen]')];
  const params = new URLSearchParams(location.search);
  const sender = Object.hasOwn(archetypes, params.get('ref')) ? params.get('ref') : null;
  const quizState = createQuizState();
  let resultSlug = null;

  const show = name => { screens.forEach(screen => screen.classList.toggle('active', screen.dataset.screen === name)); window.scrollTo({ top: 0, behavior: 'smooth' }); };
  const shareUrl = () => { const url = new URL(`r/${resultSlug}`, publicQuizUrl); url.searchParams.set('ref', resultSlug); return url; };
  const cardUrl = () => `${baseUrl}assets/cards/${resultSlug}.png`;
  // Instagram has no web link that opens a post with the card in it. On phones the Instagram button hands the card
  // image to the share sheet, where Instagram is one of the choices; elsewhere it falls back to downloading the card.
  let cardFile = null;
  const loadCardFile = () => {
    const slug = resultSlug;
    if (cardFile?.name === `bestday-${slug}.png`) return;
    fetch(cardUrl()).then(response => response.blob()).then(blob => {
      if (slug === resultSlug) cardFile = new File([blob], `bestday-${slug}.png`, { type: 'image/png' });
    }).catch(() => {});
  };
  const configureSharing = prefix => {
    const result = archetypes[resultSlug];
    const message = `${result.forward} ${shareUrl()}`;
    const whatsappLink = root.querySelector(`[data-${prefix}whatsapp]`);
    const instagramLink = root.querySelector(`[data-${prefix}instagram]`);
    const saveLink = root.querySelector(`[data-${prefix}save]`);
    loadCardFile();
    instagramLink.href = cardUrl();
    instagramLink.onclick = event => {
      track('share_click', { channel: 'instagram', archetype: resultSlug });
      if (!cardFile || !navigator.canShare?.({ files: [cardFile] })) return;
      event.preventDefault();
      navigator.share({ files: [cardFile], text: message }).catch(() => {});
    };
    whatsappLink.href = `https://wa.me/?text=${encodeURIComponent(message)}`;
    whatsappLink.onclick = () => track('share_click', { channel: 'whatsapp', archetype: resultSlug });
    saveLink.href = cardUrl();
    saveLink.onclick = () => track('card_download', { archetype: resultSlug });
    root.querySelector(`[data-${prefix}share]`).onclick = async () => {
      track('share_click', { channel: navigator.share ? 'native' : 'clipboard', archetype: resultSlug });
      if (navigator.share) await navigator.share({ title: result.name, text: result.forward, url: shareUrl().toString() });
      else await navigator.clipboard.writeText(message);
    };
  };
  const trackStep = ({ fromHistory = false } = {}) => {
    const step = stepFor(quizState.questionIndex);
    const url = new URL(location.href);
    url.searchParams.set('step', step.key);
    if (!fromHistory && url.href !== location.href) history.pushState({ step: step.key }, '', url);
    track('step_view', { step: step.number, step_key: step.key, statement: step.statement, step_count: stepCount, category: quizState.category });
  };
  const renderQuestion = ({ fromHistory = false } = {}) => {
    trackStep({ fromHistory });
    const host = root.querySelector('[data-question]');
    const { questionIndex } = quizState;
    root.querySelector('[data-back]').hidden = questionIndex === 0;
    const progressShell = root.querySelector('[data-progress-shell]');
    const stepLabel = root.querySelector('[data-step-label]');
    const showProgress = questionIndex >= 2;
    progressShell.hidden = !showProgress;
    stepLabel.hidden = !showProgress;
    if (questionIndex === 0) {
      host.innerHTML = `<h2>Which goal is on your mind most right now?</h2><div class="options">${categories.map(item => `<button class="option" data-category="${item.slug}"><span>${item.label}</span></button>`).join('')}</div>`;
      if (quizState.category) host.querySelector(`[data-category="${quizState.category}"]`)?.classList.add('selected');
      host.querySelectorAll('[data-category]').forEach(button => button.addEventListener('click', () => {
        button.classList.add('selected');
        recordCategory(quizState, button.dataset.category);
        track('question_answered', { index: 1, category: quizState.category });
        setTimeout(renderQuestion, 120);
      }));
      return;
    }
    if (questionIndex === 1) {
      host.innerHTML = `<h2>Before you start</h2><div class="intro-copy"><p>This quiz shows you your goal archetype. It takes about 3 minutes.</p><p>For each statement, say how much it sounds like you, from “Not me” to “That’s me”. Answer for how you are, not how you’d like to be.</p></div><button class="button" data-intro-start>Start quiz</button>`;
      track('intro_view', { category: quizState.category });
      host.querySelector('[data-intro-start]').onclick = () => {
        track('intro_start', { category: quizState.category });
        startQuiz(quizState);
        renderQuestion();
      };
      return;
    }
    const position = questionIndex - 1;
    const percent = Math.round((position / 20) * 100);
    stepLabel.textContent = `${percent}%`;
    stepLabel.setAttribute('aria-label', `Statement ${position} of 20, ${percent}% done`);
    root.querySelector('[data-progress]').style.width = `${percent}%`;
    const question = questions[questionIndex - 2];
    host.innerHTML = `<h2>${question.prompt}</h2><div class="scale" role="group" aria-label="How much does this sound like you?"><span>Not me</span><div class="scale-dots">${[0, 1, 2, 3, 4].map(value => `<button class="scale-dot" data-value="${value}" aria-label="${value + 1} of 5"></button>`).join('')}</div><span>That's me</span></div>`;
    const storedAnswer = quizState.answers.find(answer => answer.questionId === question.id);
    if (storedAnswer) host.querySelector(`[data-value="${storedAnswer.value}"]`)?.classList.add('selected');
    host.querySelectorAll('[data-value]').forEach(button => button.addEventListener('click', () => {
      button.classList.add('selected');
      host.querySelectorAll('[data-value]').forEach(option => { option.disabled = true; });
      recordAnswer(quizState, { questionId: question.id, value: Number(button.dataset.value) });
      track('question_answered', { index: question.id, value: Number(button.dataset.value) });
      setTimeout(() => { if (quizState.questionIndex === 22) finishQuiz(); else renderQuestion(); }, 120);
    }));
  };
  const finishQuiz = () => {
    show('loading');
    const score = scoreQuizWithDetails(quizState.answers);
    resultSlug = score.winner;
    root.querySelector('[data-even-note]').hidden = !isVeryEven(score.scores);
    const result = archetypes[resultSlug];
    root.querySelector('[data-teaser-name]').textContent = result.name;
    root.querySelector('[data-teaser-identity]').textContent = result.identity;
    root.querySelector('[data-teaser-icon]').src = `${baseUrl}assets/archetypes/${resultSlug}.png`;
    root.querySelector('[data-teaser-at-best]').textContent = result.atBest;
    root.querySelector('[data-teaser-pattern]').textContent = result.tendency;
    root.querySelector('[data-teaser-first-step-item]').hidden = !result.firstStep;
    root.querySelector('[data-teaser-more-heading]').textContent = `${result.firstStep ? 'Seven' : 'Six'} more parts of your read`;
    configureSharing('');
    track('quiz_complete', { archetype: resultSlug, category: quizState.category });
    setTimeout(() => { track('teaser_view', { archetype: resultSlug, category: quizState.category }); show('teaser'); }, 450);
  };
  const renderResult = () => {
    const result = archetypes[resultSlug];
    const categoryInfo = categories.find(item => item.slug === quizState.category) ?? categories[6];
    root.querySelector('[data-result-name]').textContent = result.name;
    root.querySelector('[data-card-line]').textContent = result.cardLine;
    root.querySelector('[data-result-icon]').src = `${baseUrl}assets/archetypes/${resultSlug}.png`;
    root.querySelector('[data-result-identity]').textContent = result.identity;
    root.querySelector('[data-result-at-best]').textContent = result.atBest;
    root.querySelector('[data-result-strength]').textContent = result.strength;
    root.querySelector('[data-result-others-see]').textContent = result.othersSee;
    const [tendencyLead, ...tendencyRest] = result.tendency.split(/(?<=\.)\s+/);
    root.querySelector('[data-result-tendency-lead]').textContent = tendencyLead;
    root.querySelector('[data-result-tendency]').textContent = tendencyRest.join(' ');
    root.querySelector('[data-result-need]').textContent = result.need;
    root.querySelector('[data-result-works-best-with]').textContent = result.worksBestWith;
    root.querySelector('[data-result-question]').textContent = result.question;
    root.querySelector('[data-result-first-step]').textContent = result.firstStep;
    root.querySelector('[data-result-first-step-section]').hidden = !result.firstStep;
    // How you fit: one figure per type (yours tagged "You"); choosing one shows that pairing's line.
    const pairings = pairingsFor(resultSlug);
    const fitTypes = root.querySelector('[data-fit-rows]');
    const fitLine = root.querySelector('[data-fit-line]');
    fitTypes.innerHTML = pairings.map(pairing => `
      <button type="button" class="fit-type${pairing.partner === resultSlug ? ' me' : ''}" data-partner="${pairing.partner}" aria-pressed="false">
        <img src="${baseUrl}assets/archetypes/${pairing.partner}.png" alt="" /><span>${archetypes[pairing.partner].name.replace('The ', '')}</span>
      </button>
    `).join('');
    const showFit = partner => {
      const pairing = pairings.find(item => item.partner === partner);
      fitTypes.querySelectorAll('[data-partner]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.partner === partner)));
      fitLine.innerHTML = '<span></span>';
      fitLine.firstChild.textContent = pairing.label;
      fitLine.append(pairing.line);
    };
    fitTypes.querySelectorAll('[data-partner]').forEach(button => {
      button.onclick = () => { showFit(button.dataset.partner); track('fit_view', { archetype: resultSlug, partner: button.dataset.partner }); };
    });
    showFit(sender ?? pairings.find(item => item.partner !== resultSlug).partner);
    root.querySelector('[data-category-dot]').style.background = categoryInfo.color;
    root.querySelector('[data-result-message]').textContent = `${result.forward} ${shareUrl()}`;
    configureSharing('result-');
    configureSharing('end-');
    if (sender) {
      const pairing = root.querySelector('[data-pairing]');
      pairing.hidden = false;
      root.querySelector('[data-pairing-heading]').textContent = `You're ${result.name}. The person who sent you this is ${archetypes[sender].name}.`;
      root.querySelector('[data-pairing-copy]').textContent = pairingFor(resultSlug, sender);
    }
    track('result_view', { archetype: resultSlug, category: quizState.category }); show('result');
  };
  root.querySelectorAll('[data-start]').forEach(button => { button.onclick = () => { track('quiz_start'); renderQuestion(); show('quiz'); }; });
  root.querySelector('[data-back]').onclick = () => { if (history.state?.step) history.back(); else { goBack(quizState); renderQuestion(); } };
  root.querySelector('[data-unlock]').onclick = () => show('capture');
  const whatsappInput = root.querySelector('[data-whatsapp-input]');
  whatsappInput.oninput = () => { root.querySelector('.whatsapp-consent').hidden = !whatsappInput.value.trim(); };
  root.querySelector('[data-capture-form]').onsubmit = async event => {
    event.preventDefault(); const form = new FormData(event.currentTarget); const status = root.querySelector('[data-form-status]'); status.textContent = 'Reading your answers...';
    try { await submitCapture({ firstName: String(form.get('firstName')), email: String(form.get('email')), whatsapp: String(form.get('whatsapp')), whatsappConsent: form.get('whatsappConsent') === 'on', consent: true, archetype: resultSlug, category: quizState.category, source: trackingContext() }, captureEndpoint); track('capture_submit', { archetype: resultSlug, category: quizState.category }); renderResult(); }
    catch { status.textContent = 'Something went wrong. Try again to see your full result.'; }
  };
  root.querySelector('[data-offer]').onclick = () => show('offer');
  root.querySelector('[data-restart]').onclick = () => location.assign(baseUrl);
  const signup = signupDestination(navigator.userAgent, siteOrigin);
  root.querySelectorAll('[data-signup]').forEach(link => {
    link.href = signup.url;
    link.onclick = () => track('signup_click', { archetype: resultSlug, category: quizState.category, platform: signup.platform });
  });
  window.addEventListener('popstate', () => {
    const questionIndex = questionIndexForStep(new URLSearchParams(location.search).get('step'));
    if (questionIndex === null) { show('landing'); return; }
    if (questionIndex > quizState.questionIndex || (questionIndex >= 2 && !quizState.category)) return;
    quizState.questionIndex = questionIndex;
    renderQuestion({ fromHistory: true });
    show('quiz');
  });
  if (params.has('step')) { const url = new URL(location.href); url.searchParams.delete('step'); history.replaceState(null, '', url); }
  track('landing_view'); if (sender) track('referral_landing', { archetype: sender });
  if (params.get('start') === '1') root.querySelector('[data-start]')?.click();
</script>

<style>
