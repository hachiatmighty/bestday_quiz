---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;
const types = [
  { slug: 'sprinter', name: 'The Sprinter', line: 'You create momentum. People feel it when you start.' },
  { slug: 'planner', name: 'The Planner', line: 'You build the structure other people borrow.' },
  { slug: 'anchor', name: 'The Anchor', line: "You're the one everyone leans on." },
  { slug: 'explorer', name: 'The Explorer', line: 'You see possibilities other people walk past.' },
  { slug: 'finisher', name: 'The Finisher', line: "You're the rare one who finishes." },
];
---
<div class="landing-page">
  <header class="landing-hero">
    <div class="landing-wrap">
      <img class="landing-logo" src={assetUrl('assets/logos/wordmark-black.png')} alt="Bestday" />
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="landing-eyebrow">Goal archetype quiz</p>
          <h1 data-landing-title>Everyone in your circle goes after goals differently.</h1>
          <p class="landing-subline">Find out how you do it, then see how your people fit with you.</p>
          <div class="landing-actions">
            <button class="landing-cta" type="button" data-start>Find my type</button>
            <button class="landing-link" type="button" data-start>Then send it to your circle</button>
          </div>
          <p class="landing-note">Free. About two minutes.</p>
          <aside class="pairing-preview">Sprinter + Anchor: one of you brings the spark, one of you keeps going when it's quiet.</aside>
        </div>
        <div class="card-fan" aria-label="The five Bestday goal archetypes">
          {types.map(type => (
            <article class="landing-type-card">
              <img src={assetUrl(`assets/archetypes/${type.slug}.png`)} alt="" />
              <strong>{type.name}</strong>
            </article>
          ))}
        </div>
      </div>
    </div>
  </header>

  <section class="landing-section how-section">
    <div class="landing-wrap">
      <h2>How it works</h2>
      <div class="steps">
        <article><b>01</b><p>Answer 20 quick questions.</p></article>
        <article><b>02</b><p>Meet your type.</p></article>
        <article><b>03</b><p>Send it to the people who'd tell you the truth.</p></article>
      </div>
    </div>
  </section>

  <section class="landing-section types-section">
    <div class="landing-wrap">
      <h2>Meet the five types</h2>
      <div class="type-grid">
        {types.map(type => (
          <article>
            <img src={assetUrl(`assets/archetypes/${type.slug}.png`)} alt="" />
            <h3>{type.name}</h3>
            <p>{type.line}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="landing-section faq-section">
    <div class="landing-wrap">
      <h2>Good to know</h2>
      <div class="faq-grid">
        <article><h3>Is it free?</h3><p>Yes.</p></article>
        <article><h3>How long does it take?</h3><p>About two minutes.</p></article>
        <article><h3>Do I need the app?</h3><p>No. The quiz works right here.</p></article>
      </div>
    </div>
  </section>

  <section class="repeat-section">
    <div class="landing-wrap">
      <h2>Ready to meet your type?</h2>
      <button class="landing-cta yellow" type="button" data-start>Find my type</button>
      <p>Free. About two minutes.</p>
    </div>
  </section>
</div>

<style>
  .landing-page{background:var(--black);color:var(--cream)}
  .landing-wrap{width:min(100% - 96px,1320px);margin:auto}
  .landing-hero{min-height:800px;padding:48px 0 76px;background:var(--yellow);color:var(--black);overflow:hidden}
  .landing-logo{width:126px;margin-bottom:54px}
  .hero-grid{display:grid;grid-template-columns:minmax(460px,.86fr) minmax(620px,1.14fr);gap:18px;align-items:center}
  .hero-copy{position:relative;z-index:10}
  .landing-eyebrow{margin:0 0 16px;font-size:.85rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
  h1,h2,h3,p{margin-top:0}
  h1,h2,h3{font-weight:800;letter-spacing:-.045em;line-height:.96}
  h1{max-width:700px;margin-bottom:24px;font-size:clamp(4rem,6.2vw,6.3rem)}
  .landing-subline{max-width:650px;margin-bottom:28px;font-size:1.5rem;line-height:1.4}
  .landing-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
  .landing-cta{min-height:62px;padding:0 32px;border:0;border-radius:999px;background:var(--black);color:var(--yellow);font-weight:800;cursor:pointer}
  .landing-cta.yellow{background:var(--yellow);color:var(--black)}
  .landing-link{padding:8px 0;border:0;border-bottom:2px solid currentColor;background:transparent;color:var(--black);font-weight:800;cursor:pointer}
  .landing-note{margin:13px 0 0;font-size:.9rem}
  .pairing-preview{max-width:660px;margin-top:30px;padding:24px;border:2px solid var(--black);border-radius:18px;font-size:1.35rem;font-weight:800;line-height:1.15}
  .card-fan{position:relative;height:620px;margin-right:-90px}
  .landing-type-card{position:absolute;top:92px;width:19%;height:340px;padding:14px;overflow:hidden;border:1px solid #34342f;border-radius:20px;background:var(--black);box-shadow:0 22px 45px #5d4e1430;color:var(--cream)}
  .landing-type-card img{width:100%;height:250px;object-fit:contain}
  .landing-type-card strong{display:block;white-space:nowrap;color:var(--yellow);font-size:clamp(.8rem,1.2vw,1.15rem)}
  .landing-type-card:nth-child(1){left:0;top:130px;transform:rotate(-11deg)}
  .landing-type-card:nth-child(2){left:20%;top:70px;transform:rotate(-6deg)}
  .landing-type-card:nth-child(3){left:40%;top:42px}
  .landing-type-card:nth-child(4){left:60%;top:70px;transform:rotate(6deg)}
  .landing-type-card:nth-child(5){left:80%;top:130px;transform:rotate(11deg)}
  .landing-section{padding:84px 0}
  .landing-section h2,.repeat-section h2{margin-bottom:42px;font-size:3.65rem}
  .how-section{background:var(--yellow);color:var(--black)}
  .steps,.faq-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .steps article{min-height:160px;padding:28px;border:2px solid var(--black);border-radius:20px}
  .steps b{display:block;margin-bottom:30px}
  .steps p{margin:0;font-size:1.55rem;font-weight:800;line-height:1.1}
  .types-section{background:var(--black)}
  .type-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
  .type-grid article{min-height:380px;padding:18px;border:1px solid #34342f;border-radius:20px}
  .type-grid img{width:100%;height:190px;object-fit:contain}
  .type-grid h3{margin:12px 0;color:var(--yellow);font-size:1.7rem}
  .type-grid p{margin:0;color:#d1cec3;line-height:1.45}
  .faq-section{background:var(--cream);color:var(--black)}
  .faq-grid article{padding-top:20px;border-top:3px solid var(--black)}
  .faq-grid h3{margin-bottom:12px;font-size:1.8rem}
  .faq-grid p{line-height:1.45}
  .repeat-section{padding:84px 0;text-align:center}
  .repeat-section h2{margin-bottom:28px}
  .repeat-section p{margin:14px 0 0;color:#aaa79e}
  @media(max-width:900px){
    .hero-grid{grid-template-columns:1fr}.card-fan{height:540px;margin:0 -30px}.type-grid{grid-template-columns:repeat(3,1fr)}
  }
  @media(max-width:600px){
    .landing-wrap{width:min(100% - 32px,520px)}.landing-hero{min-height:0;padding:28px 0 48px}.landing-logo{width:104px;margin-bottom:38px}
    .hero-grid{display:grid;gap:0}.hero-copy{display:contents}.landing-eyebrow{grid-row:1}.hero-copy h1{grid-row:2}.card-fan{grid-row:3}.landing-subline{grid-row:4}.landing-actions{grid-row:5}.landing-note{grid-row:6}.pairing-preview{grid-row:7}
    h1{font-size:3rem;margin-bottom:8px}.landing-subline{margin-bottom:18px;font-size:1.1rem}.landing-actions{display:grid;justify-items:start;gap:10px}.landing-cta{min-height:50px;padding:0 24px}.landing-link{font-size:.95rem}
    .pairing-preview{margin-top:20px;padding:18px;font-size:1.12rem}.card-fan{height:190px;margin:0 -16px 4px}
    .landing-type-card{width:19%;height:142px;padding:5px;border-radius:9px}.landing-type-card img{height:101px}.landing-type-card strong{font-size:.43rem}
    .landing-type-card:nth-child(1){left:0;top:38px;transform:rotate(-10deg)}.landing-type-card:nth-child(2){left:20%;top:16px;transform:rotate(-5deg)}.landing-type-card:nth-child(3){left:40%;top:5px}.landing-type-card:nth-child(4){left:60%;top:16px;transform:rotate(5deg)}.landing-type-card:nth-child(5){left:80%;top:38px;transform:rotate(10deg)}
    .landing-section{padding:50px 0}.landing-section h2,.repeat-section h2{margin-bottom:28px;font-size:2.4rem}.steps,.faq-grid{grid-template-columns:1fr}.steps article{min-height:0;padding:20px}.steps b{margin-bottom:14px}.steps p{font-size:1.3rem}
    .type-grid{grid-template-columns:1fr 1fr}.type-grid article{min-height:275px;padding:13px}.type-grid img{height:125px}.type-grid h3{font-size:1.3rem}.type-grid p{font-size:.86rem}.repeat-section{padding:52px 0}
  }
</style>
