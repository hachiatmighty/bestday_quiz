---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const assetUrl = (path: string) => `${base}${path.replace(/^\//, '')}`;
const types = [
  { slug: 'sprinter', name: 'The Sprinter', line: "You start before you're ready." },
  { slug: 'planner', name: 'The Planner', line: 'Your plan is better than your start date.' },
  { slug: 'anchor', name: 'The Anchor', line: 'Everyone leans on you.' },
  { slug: 'explorer', name: 'The Explorer', line: "You've already found a new idea." },
  { slug: 'finisher', name: 'The Finisher', line: "You finish everyone's things but yours." },
];
---
<div class="landing-page">
  <header class="landing-hero">
    <div class="landing-wrap hero-grid">
      <div class="hero-copy">
        <img class="landing-logo" src={assetUrl('assets/logos/wordmark-black.png')} alt="Bestday" />
        <h1 data-landing-title>Everyone in your circle goes after goals differently.</h1>
        <p class="landing-subline">Find out how you do it, then see how your people fit with you. About two minutes, no app needed.</p>
        <button class="landing-cta" type="button" data-start>Find my type</button>
      </div>
      <div class="dealt-area">
        <div class="card-fan" aria-label="The five Bestday goal archetypes">
          {types.map(type => (
            <article class="landing-type-card">
              <img src={assetUrl(`assets/archetypes/${type.slug}.png`)} alt="" />
              <strong>{type.name}</strong>
            </article>
          ))}
        </div>
        <p class="pairing-note">One of you brings the spark. One of you keeps going when it's quiet.</p>
      </div>
    </div>
  </header>

  <section class="types-section">
    <div class="list-wrap">
      <h2>Which one sounds like you?</h2>
      <div class="types-list">
        {types.map(type => (
          <article>
            <img src={assetUrl(`assets/archetypes/${type.slug}.png`)} alt="" />
            <div><h3>{type.name}</h3><p>{type.line}</p></div>
          </article>
        ))}
      </div>
      <div class="closing">
        <p>Then send it to the two or three people who'd tell you the truth.</p>
        <button class="landing-cta yellow" type="button" data-start>Find my type</button>
      </div>
    </div>
  </section>
</div>

<style>
  .landing-page{background:var(--black);color:var(--cream)}
  .landing-wrap{width:min(100% - 96px,1320px);margin:auto}
  .landing-hero{min-height:780px;padding:52px 0 72px;background:var(--yellow);color:var(--black);overflow:hidden}
  .hero-grid{display:grid;grid-template-columns:minmax(470px,.82fr) minmax(650px,1.18fr);gap:26px;align-items:center}
  .landing-logo{width:126px;margin:0 0 66px 3px}
  h1,h2,h3,p{margin-top:0}
  h1,h2,h3{font-weight:800;letter-spacing:-.045em;line-height:.96}
  h1{max-width:710px;margin-bottom:26px;font-size:clamp(4rem,6.2vw,6.3rem)}
  .landing-subline{max-width:630px;margin-bottom:30px;font-size:1.45rem;line-height:1.42}
  .landing-cta{min-height:62px;padding:0 32px;border:0;border-radius:999px;background:var(--black);color:var(--yellow);font-weight:800;cursor:pointer}
  .landing-cta.yellow{background:var(--yellow);color:var(--black)}
  .dealt-area{position:relative;height:620px;margin-right:-90px}
  .card-fan{position:absolute;inset:0}
  .landing-type-card{position:absolute;width:190px;height:340px;padding:14px;border:1px solid #34342f;border-radius:18px;background:var(--black);color:var(--cream);overflow:hidden}
  .landing-type-card img{width:100%;height:250px;object-fit:contain}
  .landing-type-card strong{display:block;color:var(--yellow);font-size:1.05rem;white-space:nowrap}
  .landing-type-card:nth-child(1){left:2%;top:108px;transform:rotate(-9deg);z-index:2}
  .landing-type-card:nth-child(2){left:43%;top:58px;transform:rotate(4deg);z-index:4}
  .landing-type-card:nth-child(3){left:20%;top:96px;transform:rotate(-2deg);z-index:3}
  .landing-type-card:nth-child(4){left:56%;top:91px;transform:rotate(7deg);z-index:5}
  .landing-type-card:nth-child(5){left:74%;top:49px;transform:rotate(-5deg);z-index:6}
  .pairing-note{position:absolute;left:2%;bottom:24px;width:390px;margin:0;font-size:1.12rem;line-height:1.35}
  .types-section{padding:92px 0 100px;background:var(--black)}
  .list-wrap{width:min(100% - 96px,1320px);margin:auto}
  .types-section h2{margin-bottom:44px;font-size:clamp(3rem,5vw,4.8rem)}
  .types-list article{display:grid;grid-template-columns:140px 1fr;gap:34px;align-items:center;min-height:176px;padding:18px 0;border-top:1px solid #45443f}
  .types-list article:last-child{border-bottom:1px solid #45443f}
  .types-list img{width:140px;height:140px;object-fit:contain}
  .types-list h3{margin:0 0 10px;color:var(--yellow);font-size:2rem}
  .types-list p{margin:0;color:#e0ddd3;font-size:1.35rem;line-height:1.35}
  .closing{max-width:720px;padding-top:62px}
  .closing p{margin-bottom:26px;font-size:2rem;font-weight:800;line-height:1.15;letter-spacing:-.025em}
  @media(max-width:900px){
    .landing-wrap{width:min(100% - 48px,760px)}.landing-hero{min-height:0;padding:34px 0 58px}.hero-grid{grid-template-columns:1fr}.landing-logo{margin-bottom:42px}
    .dealt-area{height:410px;margin:0 -20px}.landing-type-card{width:19%;height:250px;padding:9px;border-radius:13px}.landing-type-card img{height:187px}.landing-type-card strong{font-size:.72rem}
    .landing-type-card:nth-child(1){left:0;top:64px}.landing-type-card:nth-child(2){left:42%;top:25px}.landing-type-card:nth-child(3){left:19%;top:57px}.landing-type-card:nth-child(4){left:61%;top:62px}.landing-type-card:nth-child(5){left:80%;top:19px}
    .pairing-note{left:0;bottom:5px;width:360px}
    .list-wrap{width:min(100% - 48px,760px)}
  }
  @media(max-width:600px){
    .landing-wrap,.list-wrap{width:min(100% - 32px,520px)}.landing-hero{padding:28px 0 42px}.landing-logo{width:104px;margin-bottom:30px}
    h1{font-size:3rem;margin-bottom:12px}.landing-subline{font-size:1.05rem;margin:24px 0}.landing-cta{min-height:50px;padding:0 24px}
    .hero-grid{display:grid;gap:0}.hero-copy{display:contents}.landing-logo{grid-row:1}.hero-copy h1{grid-row:2}.dealt-area{grid-row:3}.landing-subline{grid-row:4}.hero-copy .landing-cta{grid-row:5;justify-self:start}
    .dealt-area{height:220px;margin:0 -16px}.landing-type-card{width:21%;height:151px;padding:5px;border-radius:9px}.landing-type-card img{height:109px}.landing-type-card strong{font-size:.43rem}
    .landing-type-card:nth-child(1){left:0;top:28px}.landing-type-card:nth-child(2){left:43%;top:5px}.landing-type-card:nth-child(3){left:20%;top:26px}.landing-type-card:nth-child(4){left:62%;top:31px}.landing-type-card:nth-child(5){left:80%;top:2px}
    .pairing-note{left:32px;bottom:0;width:300px;font-size:.9rem}
    .types-section{padding:54px 0 64px}.types-section h2{margin-bottom:26px;font-size:2.7rem}
    .types-list article{grid-template-columns:88px 1fr;gap:18px;min-height:122px;padding:16px 0}.types-list img{width:88px;height:88px}.types-list h3{margin-bottom:6px;font-size:1.45rem}.types-list p{font-size:1rem}
    .closing{padding-top:42px}.closing p{margin-bottom:22px;font-size:1.55rem}
  }
</style>
